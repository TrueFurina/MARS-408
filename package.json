    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "happy-dom": "^15.11.0",
    "lightningcss": "^1.33.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.20",
    "prettier": "3.8.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  },
  "browserslist": [
    "Chrome >= 80",
    "Edge >= 80",
    "Firefox >= 75",
    "Safari >= 14",
