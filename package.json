    "format": "prettier --write --experimental-cli src/",
    "lint": "eslint . --ext .vue,.js,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.js,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@obsidize/tar-browserify": "^6.3.2",
    "@runno/wasi": "^0.10.0",
    "@sigodenjs/marked-katex-extension": "^1.0.0",
    "@tanstack/vue-virtual": "^3.13.29",
    "@wasmer/sdk": "^0.10.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.10",
    "lucide-vue-next": "^0.577.0",
    "marked": "^15.0.12",
    "pako": "^3.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/dompurify": "^3.0.5",
