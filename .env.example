# ============================================================
# .env.example — 芒得很职 docker-compose 环境变量模板
# 复制为 .env 后按环境填写；未设值项 compose 内有 development 模式默认值。
# ⚠️ .env 含密钥，已被 .gitignore 忽略，切勿提交。
# ============================================================

# —— 镜像版本（build args）——
APP_TAG=1.0.0
BUILD_DATE=

# —— 通用 ——
LLM_PROVIDER=auto
MAX_REQUEST_BYTES=52428800
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# —— DeepSeek ——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# —— 讯飞星火（X2 权限，见项目记忆；spark-x 未授权）——
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
XF_API_PASSWORD=
XF_ACTIVE_PRESET=spark_x2

# —— 通义千问 ——
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.8-max

# —— Tavily 检索 ——
TAVILY_API_KEY=

# —— PostgreSQL（仅 --profile production 启用；开发模式由 pg_client 优雅降级 SQLite）——
PG_HOST=postgresql
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=netlearn
PG_ENABLED=true

# —— Redis（仅 --profile production）——
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# —— Milvus（生产部署向量库）——
MILVUS_ENABLED=true

# —— 鉴权 / 管理员（开发模式不填则随机生成；生产模式必填，否则 fail-fast）——
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET=

# —— 运行模式 ——
# development（默认）：播种 demo/demo123456，自动生成密钥，开箱即跑
# production（需 --profile production）：必须显式设置 ADMIN_PASSWORD / AUTH_SECRET
NETLEARN_ENV=development
