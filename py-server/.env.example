# MARS-408 环境变量配置模板
# 复制此文件为 .env 并填入实际密钥
# .env 已在 .gitignore 中，不会被提交

# ── LLM 三通道 ──
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

XF_APP_ID=your_xfyun_app_id
XF_API_KEY=your_xfyun_api_key
XF_API_SECRET=your_xfyun_api_secret
XF_API_PASSWORD=your_xfyun_api_password
XF_ACTIVE_PRESET=spark_x2

QWEN_API_KEY=your_qwen_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.8-max

# ── Tavily 搜索 ──
TAVILY_API_KEY=your_tavily_api_key

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ENABLED=false

# ── PostgreSQL ──
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_pg_password
PG_DATABASE=netlearn
PG_ENABLED=false

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_ENABLED=false

# ── CORS 允许的前端来源 (逗号分隔) ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 环境模式 ──
# development（默认）：自动生成 AUTH_SECRET/ADMIN_PASSWORD，播种 demo/demo123456 演示账号
# production：必须填写 AUTH_SECRET(>=32字符)/ADMIN_PASSWORD(>=16字符)，否则 fail-fast 启动失败
NETLEARN_ENV=development

# ── 安全（生产环境必须填写，缺失则启动失败）──
# development 模式下可不填（自动随机生成，重启失效）；production 模式下必填
AUTH_SECRET=your_random_secret_here_at_least_32_chars
ADMIN_PASSWORD=your_strong_admin_password

# ── 日志级别（可选：DEBUG/INFO/WARNING/ERROR，默认 INFO）──
LOG_LEVEL=INFO
